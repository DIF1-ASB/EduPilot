# Template only. Not installed or enabled by local implementation.
[Unit]
Description=EduPilot bounded generation worker
After=network-online.target

[Service]
Type=simple
User=edupilot
WorkingDirectory=/opt/edupilot/current
EnvironmentFile=/etc/edupilot/runtime.env
ExecStart=/usr/bin/node --import tsx scripts/generation-worker.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/edupilot
UMask=0077

[Install]
WantedBy=multi-user.target
